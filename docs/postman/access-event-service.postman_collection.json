{
  "info": {
    "_postman_id": "84fec08f-e3fa-5fc0-b4b0-15c7a46e9b22",
    "name": "tmc_access_event_service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Request mẫu theo controller hiện tại. Điền URL, ID và token tương ứng trước khi gửi; không lưu credential thật vào Git."
  },
  "item": [
    {
      "name": "Scan and gate commands",
      "item": [
        {
          "name": "Scan QR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{deviceToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseURL}}/scans",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "scans"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scanId\": \"{{scanId}}\",\n  \"stationId\": \"{{stationId}}\",\n  \"qrToken\": \"{{qrToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Confirm gate command",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{deviceToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseURL}}/commands/{{commandId}}/confirmations",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "commands",
                "{{commandId}}",
                "confirmations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"confirmationId\": \"{{confirmationId}}\",\n  \"outcome\": \"OPENED\",\n  \"occurredAt\": \"{{occurredAt}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Evidence review",
      "item": [
        {
          "name": "Pending evidence",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseURL}}/factories/{{factoryId}}/reviews?limit=50&offset=0",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "factories",
                "{{factoryId}}",
                "reviews"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Evidence detail",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseURL}}/factories/{{factoryId}}/reviews/{{confirmationId}}",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "factories",
                "{{factoryId}}",
                "reviews",
                "{{confirmationId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Review evidence",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseURL}}/factories/{{factoryId}}/reviews/{{confirmationId}}/decisions",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "factories",
                "{{factoryId}}",
                "reviews",
                "{{confirmationId}}",
                "decisions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decisionId\": \"{{decisionId}}\",\n  \"approved\": true,\n  \"reason\": \"Verified gate evidence\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
