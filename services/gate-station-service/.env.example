# ==============================================================================
# TMC-AACS - GATE-STATION-SERVICE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Local placeholder values. KEY=value, without export or surrounding quotes.

# 1. DATABASE
GATE_STATION_DB_HOST=localhost
GATE_STATION_DB_PORT=5432
GATE_STATION_DB_NAME=gate_station_db
GATE_STATION_DB_USER=gate_station_app
GATE_STATION_DB_PASSWORD=local-db-password

# 2. CONFIG SERVER
CONFIG_SERVER_URL=http://localhost:8888
CONFIG_SERVER_USERNAME=tmc-config-local
CONFIG_SERVER_PASSWORD=local-config-password

# 3. SERVICE DISCOVERY
EUREKA_URL=http://discovery-client:local-discovery-password@localhost:8761/eureka/

# 4. JWT / OAUTH2
IDENTITY_ISSUER=http://localhost:8081
IDENTITY_JWK_SET_URI=http://localhost:8081/oauth2/jwks

# 5. RABBITMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=tmc
RABBITMQ_PASSWORD=local-rabbit-password
RABBITMQ_VIRTUAL_HOST=/

# 6. APPLICATION
GATE_STATION_PORT=8083

# Enable publishing after provisioning RabbitMQ exchanges and downstream queues.
EVENTS_ENABLED=false
