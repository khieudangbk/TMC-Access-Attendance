# ==============================================================================
# TMC-AACS - API-GATEWAY ENVIRONMENT CONFIGURATION
# ==============================================================================
# Local placeholder values. KEY=value, without export or surrounding quotes.

# 1. CONFIG SERVER
CONFIG_SERVER_URL=http://localhost:8888
CONFIG_SERVER_USERNAME=tmc-config-local
CONFIG_SERVER_PASSWORD=local-config-password

# 2. SERVICE DISCOVERY
EUREKA_URL=http://discovery-client:local-discovery-password@localhost:8761/eureka/

# 3. JWT / OAUTH2
IDENTITY_ISSUER=http://localhost:8081
IDENTITY_JWK_SET_URI=http://localhost:8081/oauth2/jwks

# 4. CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# 5. APPLICATION
API_GATEWAY_PORT=8080
