# ==============================================================================
# TMC-AACS - IDENTITY-USER-SERVICE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Local placeholder values. KEY=value, without export or surrounding quotes.

# 1. DATABASE
IDENTITY_DB_HOST=localhost
IDENTITY_DB_PORT=5432
IDENTITY_DB_NAME=identity_user_db
IDENTITY_DB_USER=identity_app
IDENTITY_DB_PASSWORD=local-db-password

# 2. CONFIG SERVER
CONFIG_SERVER_URL=http://localhost:8888
CONFIG_SERVER_USERNAME=tmc-config-local
CONFIG_SERVER_PASSWORD=local-config-password

# 3. SERVICE DISCOVERY
EUREKA_URL=http://discovery-client:local-discovery-password@localhost:8761/eureka/

# 4. JWT / OAUTH2
IDENTITY_ISSUER=http://localhost:8081
IDENTITY_JWK_SET_URI=http://localhost:8081/oauth2/jwks
LOCAL_OAUTH_CLIENT_ID=tmc-local-client
LOCAL_OAUTH_CLIENT_SECRET=local-oauth-secret

# 5. RABBITMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=tmc
RABBITMQ_PASSWORD=local-rabbit-password
RABBITMQ_VIRTUAL_HOST=/

# 6. APPLICATION
IDENTITY_USER_PORT=8081

# 7. SIGNING AND INITIAL ADMIN (set the initial admin password yourself)
IDENTITY_JWK_SET_FILE=file:./.local/identity-jwks.json
IDENTITY_BOOTSTRAP_USERNAME=
IDENTITY_BOOTSTRAP_PASSWORD=
IDENTITY_WEB_REDIRECT_URI=http://localhost:3000/callback

# Enable publishing after provisioning RabbitMQ exchanges and downstream queues.
EVENTS_ENABLED=false
