# ==============================================================================
# TMC-AACS - QR-SERVICE ENVIRONMENT CONFIGURATION
# ==============================================================================
# Local placeholder values. KEY=value, without export or surrounding quotes.

# 1. DATABASE
QR_DB_HOST=localhost
QR_DB_PORT=5432
QR_DB_NAME=qr_db
QR_DB_USER=qr_app
QR_DB_PASSWORD=local-db-password

# 2. CONFIG SERVER
CONFIG_SERVER_URL=http://localhost:8888
CONFIG_SERVER_USERNAME=tmc-config-local
CONFIG_SERVER_PASSWORD=local-config-password

# 3. SERVICE DISCOVERY
EUREKA_URL=http://discovery-client:local-discovery-password@localhost:8761/eureka/

# 4. JWT / OAUTH2
IDENTITY_ISSUER=http://localhost:8081
IDENTITY_JWK_SET_URI=http://localhost:8081/oauth2/jwks

# 5. RABBITMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=tmc
RABBITMQ_PASSWORD=local-rabbit-password
RABBITMQ_VIRTUAL_HOST=/

# 6. APPLICATION
QR_SERVICE_PORT=8082
QR_TTL=60s

# QR signing key is separate from OAuth2 API signing keys
QR_ISSUER=tmc-qr
QR_JWK_SET_FILE=file:./.local/qr-jwks.json

# Enable after provisioning this service's own OAuth client in Identity
INTERNAL_APIS_ENABLED=false
INTERNAL_CLIENT_ID=
INTERNAL_CLIENT_SECRET=
IDENTITY_TOKEN_URI=http://localhost:8081/oauth2/token
IDENTITY_API_URL=http://localhost:8081

# Enable publishing after provisioning RabbitMQ exchanges and downstream queues.
EVENTS_ENABLED=false
