# Local development environment. Copy to .env and adjust if needed.
# docker compose reads .env from the repository root when invoked by make.

DB_USER=tmc
DB_PASSWORD=tmc_dev_password
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/tmc_central
EDGE_DB_URL=jdbc:postgresql://localhost:5432/tmc_edge

SERVER_PORT=8080
EDGE_SERVER_PORT=8081
APP_ENV=local
CORS_ALLOWED_ORIGINS=http://localhost:5173
FACTORY_ID=TMC-BD
