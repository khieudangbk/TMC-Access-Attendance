FROM maven:3.9-eclipse-temurin-21-alpine AS builder
WORKDIR /app

# Copy pom files for dependency caching
COPY pom.xml ./
COPY central-api/pom.xml central-api/
COPY edge-agent/pom.xml edge-agent/

# Download dependencies
RUN mvn -B -ntp dependency:go-offline -pl central-api -am

# Copy source and build
COPY central-api/src central-api/src
RUN mvn -B -ntp clean package -pl central-api -am -DskipTests

# Runtime image
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=builder /app/central-api/target/central-api-*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
